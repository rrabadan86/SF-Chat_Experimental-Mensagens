+"""Testes offline (sem rede): validam util e a montagem das chamadas ao EVO.
+
+Rode:  python -m tests.test_offline   (ou:  pytest tests/ )
+"""
+import os
+
+# Credenciais fake só para o EvoClient construir sem erro.
+os.environ.setdefault("EVO_DNS", "academia-teste")
+os.environ.setdefault("EVO_TOKEN", "secret-teste")
+
+from evo_agendamento import EvoClient, TurmaLotadaError, book_experimental  # noqa: E402
+from evo_agendamento.util import (  # noqa: E402
+    extract_email, fmt_date_evo, fmt_datetime_evo, only_digits, parse_datetime,
+    same_slot, session_free_spots, session_has_room, split_name,
+)
+
+
+def test_util():
+    assert only_digits("(62) 99999-8888") == "62999998888"
+    assert split_name("Maria da Silva") == ("Maria", "da Silva")
+    assert split_name("Maria") == ("Maria", None)
+    assert fmt_datetime_evo("2026-07-10 19:00") == "2026-07-10 19:00"
+    assert fmt_datetime_evo("10/07/2026 19:00") == "2026-07-10 19:00"
+    assert fmt_datetime_evo("2026-07-10T19:00") == "2026-07-10 19:00"
+    assert fmt_date_evo("2026-07-10 19:00") == "2026-07-10"
+    assert extract_email("meu email eh maria@ex.com, ok?") == "maria@ex.com"
+    assert parse_datetime("2026-07-10").year == 2026
+    print("test_util OK")
+
+
+class _FakeResp:
+    def __init__(self, status=200, payload=None):
+        self.status_code = status
+        self.ok = 200 <= status < 300
+        self._payload = payload if payload is not None else {}
+        self.content = b"x"
+        self.text = str(payload)
+
+    def json(self):
+        return self._payload
+
+
+def test_book_flow_builds_correct_calls():
+    calls = []
+
+    responses = {
+        ("GET", "/api/v1/prospects"): [],                       # não existe -> cria
+        ("POST", "/api/v1/prospects"): {"idProspect": 4242},
+        ("POST", "/api/v1/activities/schedule/experimental-class"): {"idActivitySession": 9001},
+    }
+
+    evo = EvoClient()
+
+    def fake_request(method, url, params=None, json=None, auth=None, timeout=None, headers=None):
+        # deriva o path a partir da url
+        path = url.replace(evo.base_url, "")
+        calls.append({"method": method, "path": path, "params": params, "json": json})
+        return _FakeResp(200, responses[(method, path)])
+
+    evo.session.request = fake_request  # injeta o stub
+
+    result = book_experimental(
+        name="Maria da Silva",
+        when="2026-07-10 19:00",
+        email="maria@ex.com",
+        phone="(62) 99999-8888",
+        activity="Pilates",
+        service="Aula Experimental",
+        branch_id=7,
+        check_capacity=False,
+        evo=evo,
+    )
+
+    # 1) buscou prospect por e-mail
+    assert calls[0]["method"] == "GET" and calls[0]["path"] == "/api/v1/prospects"
+    assert calls[0]["params"]["email"] == "maria@ex.com"
+
+    # 2) criou prospect com nome dividido, telefone só dígitos, ddi e branch
+    post_prospect = next(c for c in calls if c["path"] == "/api/v1/prospects" and c["method"] == "POST")
+    body = post_prospect["json"]
+    assert body["name"] == "Maria" and body["lastName"] == "da Silva"
+    assert body["cellphone"] == "62999998888"
+    assert body["ddi"] == "55"
+    assert body["idBranch"] == 7
+    assert "" not in body.values()  # _drop_empty tirou vazios
+
+    # 3) agendou a experimental com os params certos
+    book = next(c for c in calls if c["path"] == "/api/v1/activities/schedule/experimental-class")
+    p = book["params"]
+    assert p["idProspect"] == 4242
+    assert p["activityDate"] == "2026-07-10 19:00"
+    assert p["activity"] == "Pilates"
+    assert p["service"] == "Aula Experimental"
+    assert p["idBranch"] == 7
+
+    assert result.id_prospect == 4242
+    assert result.id_activity_session == 9001
+    assert result.prospect_created is True
+    print("test_book_flow_builds_correct_calls OK")
+
+
+def test_book_reuses_existing_prospect():
+    calls = []
+    evo = EvoClient()
+
+    def fake_request(method, url, params=None, json=None, auth=None, timeout=None, headers=None):
+        path = url.replace(evo.base_url, "")
+        calls.append({"method": method, "path": path, "params": params})
+        if method == "GET" and path == "/api/v1/prospects":
+            return _FakeResp(200, [{"idProspect": 555}])   # já existe
+        if path == "/api/v1/activities/schedule/experimental-class":
+            return _FakeResp(200, {"idActivitySession": 1})
+        raise AssertionError(f"Chamada inesperada: {method} {path}")
+
+    evo.session.request = fake_request
+    result = book_experimental(
+        name="Ana", when="2026-07-10 19:00", email="ana@ex.com",
+        activity="Yoga", service="Experimental", check_capacity=False, evo=evo,
+    )
+    assert result.id_prospect == 555
+    assert result.prospect_created is False
+    assert not any(c["method"] == "POST" and c["path"] == "/api/v1/prospects" for c in calls)
+    print("test_book_reuses_existing_prospect OK")
+
+
+def test_capacity_helpers():
+    cheia = {"allowExperimentalClass": True, "capacity": 9, "ocupation": 9, "experimentalClassSlots": 2}
+    com_vaga = {"allowExperimentalClass": True, "capacity": 9, "ocupation": 5, "experimentalClassSlots": 2}
+    sem_exp = {"allowExperimentalClass": False, "capacity": 9, "ocupation": 0}
+    assert session_free_spots(cheia) == 0 and not session_has_room(cheia)
+    assert session_free_spots(com_vaga) == 2 and session_has_room(com_vaga)   # min(4, 2)
+    assert not session_has_room(sem_exp)
+    slot = {"activityDate": "2026-07-10T19:00:00", "startTime": "19:00"}
+    assert same_slot(slot, "2026-07-10 19:00")
+    assert not same_slot(slot, "2026-07-10 20:00")
+    print("test_capacity_helpers OK")
+
+
+def test_book_raises_when_full_with_alternatives():
+    evo = EvoClient()
+    schedule = [
+        {"name": "Pilates", "activityDate": "2026-07-10T19:00:00", "startTime": "19:00",
+         "allowExperimentalClass": True, "capacity": 9, "ocupation": 9, "experimentalClassSlots": 0,
+         "idConfiguration": 1},
+        {"name": "Pilates", "activityDate": "2026-07-11T19:00:00", "startTime": "19:00",
+         "allowExperimentalClass": True, "capacity": 9, "ocupation": 3, "experimentalClassSlots": 2,
+         "idConfiguration": 2},
+    ]
+
+    def fake_request(method, url, params=None, json=None, auth=None, timeout=None, headers=None):
+        path = url.replace(evo.base_url, "")
+        if method == "GET" and path == "/api/v1/activities/schedule":
+            return _FakeResp(200, schedule)
+        raise AssertionError(f"Não deveria chamar {method} {path} com a turma lotada")
+
+    evo.session.request = fake_request
+
+    try:
+        book_experimental(name="Maria", when="2026-07-10 19:00", email="m@x.com",
+                          activity="Pilates", service="Experimental", evo=evo)
+        raise AssertionError("Deveria ter levantado TurmaLotadaError")
+    except TurmaLotadaError as e:
+        assert e.alternatives and e.alternatives[0]["when"] == "2026-07-11 19:00"
+        assert e.alternatives[0]["freeSpots"] == 2
+    print("test_book_raises_when_full_with_alternatives OK")
+
+
+def test_notify_studio_full_builds_message():
+    from evo_agendamento.orchestrator import notify_studio_full
+
+    sent = {}
+
+    class FakeZee:
+        def notify_phone(self, phone, text, name=None):
+            sent["phone"] = phone
+            sent["text"] = text
+            sent["name"] = name
+            return {"statusCode": 0}
+
+    ok = notify_studio_full(
+        FakeZee(),
+        name="Maria da Silva", phone="62999998888", when="2026-07-10 19:00",
+        alternatives=[{"when": "2026-07-11 19:00", "freeSpots": 2}],
+        studio_phone="5562985508065",
+    )
+    assert ok is True
+    assert sent["phone"] == "5562985508065"
+    assert "Maria da Silva" in sent["text"]
+    assert "62999998888" in sent["text"]
+    assert "2026-07-10 19:00" in sent["text"]
+    assert "2026-07-11 19:00" in sent["text"]      # alternativa incluída
+    print("test_notify_studio_full_builds_message OK")
+
+
+def test_notify_studio_skips_without_phone():
+    from evo_agendamento import config
+    from evo_agendamento.orchestrator import notify_studio_full
+
+    class FakeZee:
+        def notify_phone(self, *a, **k):
+            raise AssertionError("não deveria enviar sem studio_phone")
+
+    # Sem número (nem arg nem config) -> não envia, retorna False.
+    original = config.ZEE_STUDIO_PHONE
+    config.ZEE_STUDIO_PHONE = ""
+    try:
+        assert notify_studio_full(FakeZee(), name="X", phone="1", when="2026-07-10 19:00",
+                                  studio_phone="") is False
+    finally:
+        config.ZEE_STUDIO_PHONE = original
+    print("test_notify_studio_skips_without_phone OK")
+
+
+if __name__ == "__main__":
+    test_util()
+    test_capacity_helpers()
+    test_book_flow_builds_correct_calls()
+    test_book_reuses_existing_prospect()
+    test_book_raises_when_full_with_alternatives()
+    test_notify_studio_full_builds_message()
+    test_notify_studio_skips_without_phone()
+    print("\nTodos os testes offline passaram. ✅")
