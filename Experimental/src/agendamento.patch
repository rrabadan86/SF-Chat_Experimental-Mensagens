+name: Agendamento aula experimental (ZEE → EVO)
+
+# Modo automático: puxa contatos marcados no ZEE e agenda a aula experimental no EVO.
+# Também pode ser disparado manualmente (workflow_dispatch) informando os dados.
+on:
+  # schedule:
+  #   - cron: "*/15 * * * *"   # a cada 15 min (habilite quando o fluxo ZEE estiver pronto)
+  workflow_dispatch:
+    inputs:
+      name:
+        description: "Nome completo da aluna"
+        required: false
+      email:
+        description: "E-mail"
+        required: false
+      phone:
+        description: "Telefone (só números)"
+        required: false
+      when:
+        description: "Horário escolhido (ex.: 2026-07-10 19:00)"
+        required: false
+      contact_id:
+        description: "contactId no ZEE (modo from-zee)"
+        required: false
+
+jobs:
+  agendar:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+
+    env:
+      EVO_BASE_URL: ${{ secrets.EVO_BASE_URL }}
+      EVO_DNS: ${{ secrets.EVO_DNS }}
+      EVO_TOKEN: ${{ secrets.EVO_TOKEN }}
+      EVO_BRANCH_ID: ${{ secrets.EVO_BRANCH_ID }}
+      EVO_ACTIVITY: ${{ secrets.EVO_ACTIVITY }}
+      EVO_SERVICE: ${{ secrets.EVO_SERVICE }}
+      EVO_ACTIVITY_ID: ${{ secrets.EVO_ACTIVITY_ID }}
+      EVO_SERVICE_ID: ${{ secrets.EVO_SERVICE_ID }}
+      ZEE_BASE_URL: ${{ secrets.ZEE_BASE_URL }}
+      ZEE_TOKEN: ${{ secrets.ZEE_TOKEN }}
+      ZEE_AUTH_HEADER: ${{ secrets.ZEE_AUTH_HEADER }}
+      ZEE_AUTH_SCHEME: ${{ secrets.ZEE_AUTH_SCHEME }}
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: Install deps
+        run: python -m pip install requests python-dotenv
+
+      - name: Agendar (from-zee ou book, conforme inputs)
+        run: |
+          if [ -n "${{ inputs.contact_id }}" ]; then
+            python run_agendamento.py from-zee \
+              --contact-id "${{ inputs.contact_id }}" \
+              ${{ inputs.when && format('--when "{0}"', inputs.when) || '' }}
+          else
+            python run_agendamento.py book \
+              --name "${{ inputs.name }}" \
+              --email "${{ inputs.email }}" \
+              --phone "${{ inputs.phone }}" \
+              --when "${{ inputs.when }}"
+          fi
