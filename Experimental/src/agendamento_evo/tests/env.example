# === AppNext login ===
APPNEXT_REDE=teashop
APPNEXT_USER=openmall.palmas@teashop.com.br
APPNEXT_PASS=***

# === Drive / rclone ===
DRIVE_REMOTE=GDRIVE:
DRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DRIVE_FILE_NAME=importacaoA.xlsx

# === Datas (dd/mm/aaaa). DATA_FIM vazio => hoje ===
DATA_INICIO=01/06/2025
DATA_FIM=

# === Modelo do Excel ===
TEMPLATE_XLSX=importacaoA.xlsx
TEMPLATE_HEADER_ROW=2

# === (Opcional) Forçar loja pelo ID no fallback ===
APPNEXT_LOJA_ID_DESTINO=

# === (Opcional) Incluir token OAuth OU Service Account para rclone ===
# RCLONE_TOKEN é um JSON (token/refresh) obtido do "rclone config" (remoto GDRIVE).
# RCLONE_CONFIG_GDRIVE_SERVICE_ACCOUNT_FILE deve conter o JSON da SA em BASE64.
RCLONE_TOKEN=
RCLONE_CONFIG_GDRIVE_SERVICE_ACCOUNT_FILE=

# ============================================================
# === Agendamento de aula experimental no EVO (run_agendamento.py) ===
# ============================================================
# --- EVO (W12 / abcevo) ---
# Auth Basic: usuário = DNS da academia, senha = Secret Key.
# IMPORTANTE: no .env não coloque comentário na mesma linha do valor.
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br
EVO_DNS=
EVO_TOKEN=
# EVO_BRANCH_ID: obrigatório só em chave multi-filial (deixe vazio se não for)
EVO_BRANCH_ID=
EVO_DDI=55

# Identifique a aula experimental por NOME ou por ID. Descubra os valores com:
#   python run_agendamento.py services
#   python run_agendamento.py slots --date AAAA-MM-DD
# EVO_ACTIVITY = nome da atividade (ex.: Pilates)
EVO_ACTIVITY=
# EVO_SERVICE = nome do serviço "aula experimental"
EVO_SERVICE=
# EVO_ACTIVITY_ID / EVO_SERVICE_ID = alternativa ao nome (por id)
EVO_ACTIVITY_ID=
EVO_SERVICE_ID=

# Venda do serviço (aula experimental costuma ser gratuita):
# EVO_SERVICE_VALUE = valor da venda (0 = grátis)
EVO_SERVICE_VALUE=0
# EVO_PAYMENT = forma de pagamento (EFormaPagamentoTotem).
#   VAZIO = sem cobrança (recomendado p/ grátis). 1 exige cartão de crédito.
#   Se pedir forma de pagamento, tente 3 (Dinheiro) ou 4.
EVO_PAYMENT=

# --- ZEE ---
ZEE_BASE_URL=https://magic.zee.tech/api/v1
ZEE_TOKEN=
# Auth do ZEE: API key no header "z-api-key" (token cru, scheme vazio). Já são os padrões.
ZEE_AUTH_HEADER=z-api-key
ZEE_AUTH_SCHEME=
# Chaves do metadata do contato onde a IA do ZEE grava e-mail e horário (se gravar):
ZEE_META_EMAIL_KEY=email
ZEE_META_WHEN_KEY=horario
# Tags do fluxo automático:
# ZEE_TAG_TODO = tag aplicada quando a aluna finaliza o agendamento na conversa.
#   "FX 3 - Agendou AE"
ZEE_TAG_TODO=341fb893-a336-4f60-a675-5383969c7cf9
# ZEE_TAG_DONE = tag que marcamos após agendar no EVO (idempotência: não repete).
#   "FX 4 - Feito"
ZEE_TAG_DONE=a7cf28be-e50f-4a47-b6ed-7ab20d4245b7

# --- Turma lotada: avisar o WhatsApp do Studio (recepção resolve manual) ---
# Número (só dígitos, com DDI) que recebe o aviso quando não há vaga.
# Padrão já é o número do Studio; sobrescreva só se mudar.
ZEE_STUDIO_PHONE=5562985508065
ZEE_STUDIO_NAME=Studio
# (Opcional) Personalizar a mensagem. Placeholders: {name} {phone} {when} {alternatives}
# ZEE_FULL_MSG_TEMPLATE=
