# Restos da antiga integração com o Instagram (cookies = acesso à conta) — NUNCA versionar
instagram-chrome-data/
instagram-login-*.png
instagram-cookies.json
# Credenciais (conta de serviço do Google) — NUNCA versionar
service-account.json
*service-account*.json
# Screenshots de debug
debug-*.png
# Backups locais da pasta data/ — por servidor
backups/

# data/ = estado VIVO de cada servidor: chaves (push-vapid, sessões, usuários),
# dados pessoais (contatos, Slim Club, formulários) e os marcadores de "JÁ ENVIEI".
# Nada daqui vai para o Git: se um marcador entrasse, um git reset do servidor o
# sobrescreveria e o robô reenviaria tudo. Arquivo novo em data/ já nasce protegido.
data/*
!data/.gitkeep

# Fila de confirmações e seus marcadores (enviados/falhas/retidas) + backups
src/agendamento_evo/confirmacoes_outbox.jsonl
src/agendamento_evo/confirmacoes_outbox_enviados.json
src/agendamento_evo/confirmacoes_outbox_falhas.json
src/agendamento_evo/confirmacoes_outbox_retidas.json
