# ============================================================================
#  MODELO DE CONFIGURAÇÃO — Robô SlimFit (VPS)
# ----------------------------------------------------------------------------
#  Copie este arquivo para ".env" na mesma pasta e preencha com os dados da
#  franquia:   cp .env.example .env
#
#  NUNCA suba o ".env" para o GitHub (ele tem senhas). O ".env.example" pode.
#  Os campos marcados [POR UNIDADE] mudam em cada cliente.
# ============================================================================


# ===================== 1) IDENTIDADE DA UNIDADE =============================
# Nome do Studio como aparece nas mensagens para a aluna.  [POR UNIDADE]
STUDIO_NOME=Studio SlimFit Nome-Da-Unidade

# Mapa professora -> arquivo de áudio (pós-aula), em JSON. A chave é o nome da
# professora como aparece no EVO (minúsculo); o valor é o nome do arquivo de
# áudio (sem extensão) dentro da pasta de áudios.  [POR UNIDADE]
# Ex.: AUDIO_MAP={"ana":"A-Ana-Pos","carla":"A-Carla-Pos"}
AUDIO_MAP={"professora1":"A-Prof1-Pos","professora2":"A-Prof2-Pos"}


# ===================== 2) ACESSO AO EVO ====================================
# Endereço base do EVO da unidade.  [POR UNIDADE]
EVO_URL=https://slimfit.w12app.com.br
# Login do EVO.  [POR UNIDADE]
EVO_EMAIL=usuario@dominio.com
EVO_PASSWORD=senha-do-evo
# Caminhos internos do EVO. O número no meio é a FILIAL da unidade.  [POR UNIDADE]
EVO_LOGIN_PATH=#/acesso/slimfit/autenticacao
EVO_EXPERIMENTAL_PATH=#/app/slimfit/15/gerencial/aula-experimental
# Hashes das telas legadas (Faltantes / Suspensões), quando usadas.  [POR UNIDADE]
# Preencha só se a unidade usar essas telas antigas; deixe em branco se não usar.
EVO_FALTANTES_HASH=
EVO_SUSPENSOES_HASH=


# ===================== 3) GRUPO DA EQUIPE ==================================
# Nome EXATO do grupo interno no WhatsApp (copie e cole, com emojis).  [POR UNIDADE]
GRUPO_EQUIPE=Equipe SlimFit


# ===================== 4) PLANILHA (GOOGLE SHEETS) =========================
# ID da planilha (a parte no meio da URL entre /d/ e /edit).  [POR UNIDADE]
SHEETS_ID=
# Nome da aba que o robô atualiza.  [POR UNIDADE]
SHEETS_ABA=Alunas
# Caminho do arquivo JSON da conta de serviço do Google (chave).  [POR UNIDADE]
# A planilha precisa ser COMPARTILHADA (Editor) com o e-mail dessa conta.
GOOGLE_SA_KEY=./google-sa.json


# ===================== 5) ALERTAS (ntfy) ===================================
# Tópico exclusivo da unidade (um nome secreto, difícil de adivinhar).  [POR UNIDADE]
NTFY_TOPIC=slimfit-alertas-unidade-xxxx
# Servidor ntfy (padrão público). Só mude se usar servidor próprio.
NTFY_URL=https://ntfy.sh


# ===================== 6) REGRAS DE NEGÓCIO ================================
# Dias sem presença para entrar na lista de ausentes (padrão 10).
AUSENTES_DIAS=10
# Janela (dias) para trás usada ao cruzar com trancamentos (padrão 30).
TRANC_LOOKBACK_DIAS=30


# ===================== 7) FORMULÁRIO / PONTE ===============================
# URL do formulário na nuvem (Render) desta unidade.  [POR UNIDADE]
FORM_CLOUD_URL=https://sf-formularioexperimental.onrender.com
# Token compartilhado entre o formulário (Render) e o robô (mesmo valor nos dois).  [POR UNIDADE]
FORM_OUTBOX_TOKEN=troque-por-um-token-secreto


# ===================== 8) NAVEGADOR / WHATSAPP =============================
# Rodar sem interface gráfica (no servidor, sempre "true").
HEADLESS=true
WA_HEADLESS=true
# Pasta onde fica a SESSÃO do WhatsApp (login). NÃO copiar entre unidades —
# cada unidade escaneia o próprio QR e cria a sua.
WA_AUTH_DIR=./.wwebjs_auth
# Caminho do Chromium/Chrome no servidor (descubra com: which chromium-browser).
CHROMIUM_PATH=/usr/bin/chromium-browser


# ===================== 9) INSTAGRAM (opcional, desligado) ==================
# Boas-vindas a novos seguidores. Fica DESLIGADO por padrão (a Meta bloqueia
# a partir de servidor). Só ligue com um proxy/IP residencial.
IG_ENABLED=false
# IG_USERNAME=
# IG_PASSWORD=
# IG_PROXY=


# ===================== 10) PAINEL WEB =======================================
# Porta interna do painel (o HTTPS público é feito pelo Caddy por cima).
PAINEL_PORT=8080
# Escuta só no localhost do VPS (acesso via Caddy/túnel — nunca direto na net).
PAINEL_HOST=127.0.0.1
# Login do super-admin do painel.  [POR STUDIO]
PAINEL_USER=admin
PAINEL_SENHA=troque-por-uma-senha-forte
# Segredo que assina o cookie de sessão (qualquer texto longo aleatório).  [POR STUDIO]
PAINEL_SESSAO_SEGREDO=
# (Opcional) URL pública do painel — usada em links/redirect do formulário.
# PAINEL_URL=https://painel-do-studio.exemplo.com


# ===================== 11) DADOS VIVOS DA SOFIA =============================
# Pasta (FORA do repo) onde ficam prompt/estado/pontes da SoFIA. TEM que ser a
# MESMA em ChatBot/.env. Ex.: /root/sofia-data-<studio>.  [POR STUDIO]
SOFIA_DIR=/root/sofia-data


# ===================== 12) AGENDAMENTO PELO EVO (API W12) ===================
# Estes alimentam a grade do formulário e o agendamento da SoFIA. Descubra os
# ids com:  python src/agendamento_evo/run_agendamento.py services   [POR STUDIO]
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br
EVO_DNS=
EVO_TOKEN=
EVO_BRANCH_ID=
EVO_ACTIVITY=
EVO_SERVICE=
# (ou por id) EVO_ACTIVITY_ID= / EVO_SERVICE_ID=
# Token compartilhado com o formulário para o push da grade (push_slots).  [POR STUDIO]
FORM_SLOTS_TOKEN=
# Telefone do Studio (com DDI) que recebe o alerta de turma lotada.  [POR STUDIO]
ZEE_STUDIO_PHONE=
