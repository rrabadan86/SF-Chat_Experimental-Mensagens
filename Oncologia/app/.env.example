# ---------- servidor ----------
# production faz o cookie do painel sair com a marca Secure (exige HTTPS).
# Em desenvolvimento, deixe vazio ou "development".
NODE_ENV=production
# Atras de um nginx, escute so no localhost: assim a porta nao fica exposta na
# internet nem se o firewall falhar. Em container, use 0.0.0.0.
HOST=127.0.0.1
PORT=3000
TZ_OFFSET=-03:00
FUSO=America/Sao_Paulo

# Protege a rota /tarefas/cobrar-pendentes, chamada pelo cron. Invente um texto
# aleatorio longo -- sem ele, qualquer um poderia disparar a cobranca.
TAREFAS_TOKEN=

# Endereco publico do site, usado nas tags de compartilhamento, no canonical e
# no sitemap. Em branco, e deduzido do cabecalho da requisicao -- o que basta
# atras de um proxy bem configurado.
SITE_URL=

# ---------- painel do medico ----------
# Gere as duas linhas abaixo com:  npm run senha
# Sem elas o painel em /admin nao abre.
ADMIN_SENHA_HASH=
ADMIN_SEGREDO=
ADMIN_SESSAO_HORAS=12

# ---------- Google Agenda ----------
# ATENCAO: locais de atendimento, horarios e IDs de agenda agora sao editados
# PELO PAINEL (/admin) e ficam gravados em dados/config.json.
# As variaveis abaixo sao so a SEMENTE da primeira execucao -- depois disso,
# mexer nelas nao muda mais nada. Pode deixar vazias e cadastrar tudo pela tela.
CAL_H1=
CAL_H2=

# Agendas extras que so entram na checagem de disponibilidade (nunca recebem
# evento) -- ex.: a agenda pessoal do medico. Tambem editavel pelo painel.
CAL_BLOQUEIOS=

# onde gravar a configuracao editada pelo painel
# DADOS_ARQUIVO=./dados/config.json

# Credencial da conta de servico. Use UMA das duas:
#   caminho do arquivo json baixado do Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credenciais.json
#   ou o json inteiro numa linha so (util em Render/Railway/Heroku)
# GOOGLE_CREDENTIALS_JSON=

# ---------- WhatsApp ----------
# log    = nao envia nada, so imprime no console (use para desenvolver)
# wwebjs = WhatsApp Web (whatsapp-web.js) no numero do consultorio -- CUSTO ZERO,
#          e a opcao recomendada: nao ha cobranca por mensagem nem template a aprovar
# cloud  = WhatsApp Cloud API oficial da Meta -- COBRA por mensagem que o sistema
#          inicia; so vale a pena se o volume crescer e a estabilidade virar critica
WA_DRIVER=log

# numero da recepcionista, so digitos, com DDI: 5562999999999
# (semente da primeira execucao; depois disso edite pelo painel)
WA_RECEPCAO=

# --- se WA_DRIVER=wwebjs ---
WA_AUTH_DIR=./wwebjs_auth
WA_HEADLESS=true
# Deixe vazio para usar o Chromium que o Puppeteer baixa junto com o
# whatsapp-web.js -- e o mais confiavel. So preencha se quiser apontar para um
# navegador especifico (e nunca para o snap do Ubuntu 24.04, que roda confinado).
# CHROMIUM_PATH=

# --- se WA_DRIVER=cloud ---
# WA_CLOUD_TOKEN=
# WA_CLOUD_PHONE_ID=
# WA_CLOUD_VERIFY_TOKEN=
# nome do template aprovado para avisar o paciente (mensagem iniciada pelo sistema)
# WA_TEMPLATE_PACIENTE=confirmacao_consulta

# ---------- medico (semente da primeira execucao; depois, pelo painel) ----------
MEDICO_NOME=
MEDICO_CRM=
MEDICO_ESPECIALIDADE=Oncologia Clinica
RECEPCAO_NOME=

# ---------- regras ----------
# horas ate a recepcao confirmar antes de o sistema cobrar de novo
CONFIRMACAO_PRAZO_HORAS=24
# avisar o paciente automaticamente quando a recepcao confirmar
AVISAR_PACIENTE=true
