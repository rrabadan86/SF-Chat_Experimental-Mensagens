# ============================================================================
#  MODELO DE CONFIGURAÇÃO — SoFIA (chatbot do WhatsApp)
# ----------------------------------------------------------------------------
#  Copie para ".env" nesta pasta e preencha:   cp .env.example .env
#  NUNCA suba o ".env" para o GitHub (tem a chave da IA). O ".example" pode.
#  Campos [POR STUDIO] mudam em cada cliente.
# ============================================================================

# ===== IA (Anthropic) =====
# Chave da API da Claude. Tem custo por conversa.  [POR STUDIO ou sua chave]
ANTHROPIC_API_KEY=

# ===== Pasta de dados vivos =====
# Onde ficam prompt/estado/pontes da SoFIA, FORA do repositório. TEM que ser
# EXATAMENTE a mesma do painel (Experimental/.env).  [POR STUDIO]
SOFIA_DIR=/root/sofia-data

# ===== Formulário desta unidade (a SoFIA agenda por aqui) =====
# Endpoint do formulário na Render.  [POR STUDIO]
SOFIA_BOOK_URL=https://SEU-FORM.onrender.com/api/book-sofia
# (derivado do book quando vazio) endpoint da grade de horários:
# SOFIA_SLOTS_URL=
# Token que a SoFIA envia ao formulário (X-Sofia-Token). O MESMO valor precisa
# estar configurado no formulário (Render).  [POR STUDIO]
SOFIA_TOKEN=

# ===== Transcrição de áudio (opcional) =====
# Se preenchida, a SoFIA entende áudios (fala->texto). Chave OpenAI (Whisper)
# ou Groq. Deixe em branco para desligar.  [OPCIONAL]
# TRANSCRICAO_API_KEY=
# TRANSCRICAO_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRICAO_MODELO=whisper-1

# ===== Avançado (têm padrões; mude só se precisar) =====
# Pasta da sessão do WhatsApp da SoFIA (login por QR — não copie entre studios):
# SOFIA_WA_AUTH=
# Chromium no servidor:
# SOFIA_HEADLESS=true
# Modelo de IA e ritmo são configurados PELO PAINEL (não precisam de .env).
